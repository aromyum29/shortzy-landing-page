{
  "brand": {
    "name": "Shortzy",
    "tagline": "Long video in. Shorts out.",
    "status": "Version 3.2: separate mascot action assets and full application state system",
    "paletteSource": "User requested a new maroon and grey direction; replaces the earlier purple palette."
  },
  "color": {
    "palette": {
      "pebbleGrey": "#C9C5C1",
      "softCoral": "#E7ADA0",
      "roseClay": "#E9D6D2",
      "warmPaper": "#F3F1EE",
      "oatGold": "#D5C28F",
      "maroon": "#702F42",
      "ink": "#292628",
      "white": "#FFFFFF",
      "muted": "#625B60",
      "deepMaroon": "#43202B"
    },
    "semantic": {
      "background": "#F3F1EE",
      "surface": "#FFFFFF",
      "text": "#292628",
      "textMuted": "#625B60",
      "primary": "#702F42",
      "onPrimary": "#FFFFFF",
      "accent": "#E7ADA0",
      "onAccent": "#292628",
      "border": "#625B60",
      "focus": "#702F42",
      "disabledBackground": "#E9D6D2",
      "disabledText": "#292628",
      "decorativeBorder": "#C9C5C1",
      "controlBorder": "#625B60"
    }
  },
  "type": {
    "family": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "size": {
      "caption": 12,
      "small": 14,
      "body": 16,
      "lead": 20,
      "heading": 32,
      "display": 56
    },
    "lineHeight": {
      "body": 1.55,
      "heading": 1.1
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radius": {
    "control": 12,
    "card": 24,
    "pill": 999
  },
  "motion": {
    "fast": 120,
    "normal": 200,
    "celebration": 400,
    "easing": "cubic-bezier(.2,.8,.2,1)"
  },
  "mascot": {
    "directory": "assets/mascot/",
    "format": "RGBA PNG",
    "displayAspectRatio": "1 / 1",
    "objectFit": "contain",
    "poses": {
      "welcome": {
        "file": "assets/mascot/welcome.png",
        "width": 1381,
        "height": 1139,
        "format": "PNG",
        "transparent": true,
        "useFor": [
          "welcome",
          "idle"
        ]
      },
      "thinking": {
        "file": "assets/mascot/thinking.png",
        "width": 1254,
        "height": 1254,
        "format": "PNG",
        "transparent": true,
        "useFor": [
          "analyzing"
        ]
      },
      "clipping": {
        "file": "assets/mascot/clipping.png",
        "width": 1254,
        "height": 1254,
        "format": "PNG",
        "transparent": true,
        "useFor": [
          "results",
          "found",
          "exporting"
        ]
      },
      "celebration": {
        "file": "assets/mascot/celebration.png",
        "width": 1254,
        "height": 1254,
        "format": "PNG",
        "transparent": true,
        "useFor": [
          "complete",
          "done"
        ]
      }
    },
    "stateToPose": {
      "idle": "welcome",
      "validating": null,
      "uploading": null,
      "queued": null,
      "analyzing": "thinking",
      "results": "clipping",
      "empty": null,
      "editing": null,
      "unsaved": null,
      "exporting": "clipping",
      "partial": null,
      "complete": "celebration",
      "cancelled": null,
      "error": null,
      "offline": null,
      "credentials": null,
      "rateLimited": null,
      "storageFull": null,
      "welcome": "welcome",
      "found": "clipping",
      "done": "celebration"
    },
    "referenceSheet": "references/mascot-concept-sheet.png",
    "notes": "Four individual transparent assets, generated from the selected concept sheet. They are faithful standalone renditions, not lossless pixel crops. UI uses individual images; no sprite cropping. Match UI colours to tokens, not sampled raster pixels."
  },
  "interaction": {
    "primary": {
      "default": {
        "background": "#702F42",
        "text": "#FFFFFF"
      },
      "hover": {
        "background": "#612539",
        "text": "#FFFFFF"
      },
      "pressed": {
        "background": "#522030",
        "text": "#FFFFFF"
      },
      "selected": {
        "background": "#E9D6D2",
        "text": "#522030",
        "border": "#702F42"
      },
      "disabled": {
        "background": "#E4E1DD",
        "text": "#625B60",
        "border": "#E4E1DD"
      },
      "loading": {
        "background": "#702F42",
        "text": "#FFFFFF"
      }
    },
    "secondary": {
      "default": {
        "background": "#FFFFFF",
        "text": "#702F42",
        "border": "#702F42"
      },
      "hover": {
        "background": "#F3F1EE",
        "text": "#612539",
        "border": "#612539"
      },
      "pressed": {
        "background": "#E9D6D2",
        "text": "#522030",
        "border": "#522030"
      }
    },
    "ghost": {
      "default": {
        "background": "transparent",
        "text": "#702F42"
      },
      "hover": {
        "background": "#F3F1EE",
        "text": "#612539"
      },
      "pressed": {
        "background": "#E9D6D2",
        "text": "#522030"
      }
    },
    "destructive": {
      "default": {
        "background": "#982D3F",
        "text": "#FFFFFF"
      },
      "hover": {
        "background": "#822335",
        "text": "#FFFFFF"
      },
      "pressed": {
        "background": "#6C1D2C",
        "text": "#FFFFFF"
      }
    },
    "field": {
      "default": {
        "background": "#FFFFFF",
        "text": "#292628",
        "border": "#625B60"
      },
      "hover": {
        "border": "#702F42"
      },
      "focus": {
        "border": "#702F42"
      },
      "readOnly": {
        "background": "#F3F1EE",
        "text": "#625B60",
        "border": "#625B60"
      },
      "disabled": {
        "background": "#E4E1DD",
        "text": "#625B60",
        "border": "#E4E1DD"
      }
    },
    "focus": {
      "color": "#702F42",
      "onDark": "#F3F1EE",
      "widthPx": 3,
      "offsetPx": 4
    },
    "selection": {
      "background": "#E9D6D2",
      "text": "#522030",
      "border": "#702F42"
    },
    "neutral": {
      "hover": "#F3F1EE",
      "pressed": "#E7E3DE"
    },
    "link": {
      "default": "#702F42",
      "hover": "#612539",
      "pressed": "#522030",
      "visited": "#625B60"
    },
    "scrim": "#29262899"
  },
  "feedback": {
    "success": {
      "foreground": "#2E6751",
      "background": "#E8F0EB",
      "border": "#2E6751"
    },
    "warning": {
      "foreground": "#795516",
      "background": "#F5ECD8",
      "border": "#795516"
    },
    "error": {
      "foreground": "#982D3F",
      "background": "#F8E8EA",
      "border": "#982D3F"
    },
    "info": {
      "foreground": "#3C5872",
      "background": "#E9EFF5",
      "border": "#3C5872"
    }
  },
  "applicationStates": {
    "idle": {
      "mascot": "welcome",
      "role": "status",
      "action": "Add video"
    },
    "validating": {
      "mascot": null,
      "role": "status",
      "action": "Cancel"
    },
    "uploading": {
      "mascot": null,
      "role": "status",
      "action": "Cancel"
    },
    "queued": {
      "mascot": null,
      "role": "status",
      "action": "Remove from queue"
    },
    "analyzing": {
      "mascot": "thinking",
      "role": "status",
      "action": "Cancel"
    },
    "results": {
      "mascot": "clipping",
      "role": "status",
      "action": "Review clips"
    },
    "empty": {
      "mascot": null,
      "role": "status",
      "action": "Adjust range"
    },
    "editing": {
      "mascot": null,
      "role": null,
      "action": "Save changes"
    },
    "unsaved": {
      "mascot": null,
      "role": "status",
      "action": "Save changes"
    },
    "exporting": {
      "mascot": "clipping",
      "role": "status",
      "action": "Cancel"
    },
    "partial": {
      "mascot": null,
      "role": "status",
      "action": "Retry failed clips"
    },
    "complete": {
      "mascot": "celebration",
      "role": "status",
      "action": "Open exports"
    },
    "cancelled": {
      "mascot": null,
      "role": "status",
      "action": "Start again"
    },
    "error": {
      "mascot": null,
      "role": "alert",
      "action": "Retry"
    },
    "offline": {
      "mascot": null,
      "role": "status",
      "action": "Retry connection"
    },
    "credentials": {
      "mascot": null,
      "role": "alert",
      "action": "Open settings"
    },
    "rateLimited": {
      "mascot": null,
      "role": "status",
      "action": "Retry when available"
    },
    "storageFull": {
      "mascot": null,
      "role": "alert",
      "action": "Choose output folder"
    }
  }
}
